# UN Digital Library Scraper — Environment Variables
# Copy this file to .env and fill in actual values before running locally.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------
# Turso (LibSQL) Database — REQUIRED
# Obtain from: Turso Dashboard -> Your Database -> Connect -> libsql
# -----------------------------------------------------------------------
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# -----------------------------------------------------------------------
# Gemini API — REQUIRED for scraper tagging
# Obtain from: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------
LOG_LEVEL=INFO
PIPELINE_SOURCE_TABLE=un_votes_with_sc

# Optional UN Digital Library browser cookie, also supported as an Actions secret.
# Store the cookie value only. Refresh the secret when it expires or is rejected.
AWS_WAF_TOKEN=

# Optional explicit paths; the workflow supplies a matching Chrome/ChromeDriver pair.
# CHROME_BINARY=/path/to/chrome
# CHROMEDRIVER_PATH=/path/to/chromedriver

# CI defaults to headless; the GitHub workflow uses 0 with Xvfb.
# CHROME_HEADLESS=1
